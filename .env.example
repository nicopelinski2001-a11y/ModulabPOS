# Migrador/CLI: propietario de esquema. Nunca usar esta identidad en el servidor.
ADMIN_DATABASE_URL=postgresql://modulab_admin:CHANGE_ME_ADMIN@localhost:5432/modulab
# Runtime: rol sin propiedad, sin SUPERUSER y sin BYPASSRLS.
DATABASE_URL=postgresql://modulab_app:CHANGE_ME_APP@localhost:5432/modulab
APP_DATABASE_PASSWORD=CHANGE_ME_APP
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Generar: openssl rand -hex 32. Mínimo 32 caracteres.
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_32_CHARS
# Sólo para crear datos de evaluación. El seed se niega en producción.
SEED_PASSWORD=CHANGE_ME_DEVELOPMENT_PASSWORD

# Adaptadores funcionales locales: nunca cobran ni autorizan fiscalmente.
PAYMENT_PROVIDER=manual
FISCAL_PROVIDER=commercial
# Opcionales para el proceso de backup (mínimo 7 días; vacío conserva todas).
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=/ruta/disco-externo/backups
